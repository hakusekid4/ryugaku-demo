{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "login": true,
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "留学エージェント（デモ）",
        "blogdescription": "手数料0円の留学エージェント",
        "permalink_structure": "/%postname%/",
        "timezone_string": "Asia/Tokyo",
        "blog_public": "0"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/hakusekid4/ryugaku-demo/main/ryugaku.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; wp_delete_post( 1, true ); wp_delete_post( 2, true ); ryugaku_create_required_pages(); ryugaku_import_demo_content(); flush_rewrite_rules();"
    }
  ]
}
