{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai-config-guard.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai-config-guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai-config-conflict-guard.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai-config-conflict-guard.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-tree:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(python -m unittest discover:*)",
      "Bash(python3 -m unittest discover:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.key)"
    ]
  }
}
